{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HireFlowCalibrationDataset",
  "description": "Validation schema for ATS Roaster evaluation cases and human verdicts",
  "type": "object",
  "required": ["version", "datasetType", "cases"],
  "properties": {
    "version": { "type": "string" },
    "datasetType": { "type": "string", "enum": ["synthetic", "anonymized_real"] },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "resumeFile", "jdFile", "humanVerdict", "labellerNote", "isSynthetic"],
        "properties": {
          "id": { "type": "string" },
          "resumeFile": { "type": "string" },
          "jdFile": { "type": "string" },
          "humanVerdict": { "type": "string", "enum": ["shortlist", "maybe", "reject"] },
          "labellerNote": { "type": "string" },
          "isSynthetic": { "type": "boolean" }
        }
      }
    }
  }
}
