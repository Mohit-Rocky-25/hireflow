#!/bin/sh
# HireFlow AI — Pre-Commit Quality & Security Gate (P-5, P-7, R1.6)
# Runs secret scanning, typescript typecheck, and critical unit tests.

set -e

echo "🔒 [HireFlow Pre-Commit] 1/3 Running security secret scan..."
if [ -f "scripts/security/scan-secrets.mjs" ]; then
  node scripts/security/scan-secrets.mjs --staged
fi

echo "🔍 [HireFlow Pre-Commit] 2/3 Checking TypeScript compilation..."
npx tsc --noEmit

echo "🧪 [HireFlow Pre-Commit] 3/3 Validating datasets & privacy..."
npx vitest run src/data/__tests__/validateData.test.ts tests/privacy-telemetry.test.ts

echo "✅ [HireFlow Pre-Commit] All quality gates passed!"
exit 0
