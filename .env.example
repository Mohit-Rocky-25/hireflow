# HireFlow Cloud Configuration (Copy to .env.local or deployment environment)
# Never commit real credentials or service-role keys to source control.

# Required: Supabase Project URL (e.g. https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# Required: Supabase Public Anon Key (safe for browser use with RLS enabled)
# NEVER put SUPABASE_SERVICE_ROLE_KEY in any VITE_* variable.
VITE_SUPABASE_ANON_KEY=

# Optional: Explicit canonical site origin used for OAuth callbacks in production
# Defaults to window.location.origin when omitted.
VITE_PUBLIC_SITE_URL=
