# HireFlow AI Resume Tailoring Environment Configuration

# Server-Side AI Provider Configuration (Optional - Never expose to client bundles)
# If left empty, HireFlow operates in high-performance local deterministic mode with 0 external costs.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Application Mode
VITE_APP_ENV=development
VITE_ENABLE_LOCAL_AI_FALLBACK=true

# Security Settings
MAX_UPLOAD_SIZE_BYTES=5242880
SESSION_STORAGE_ENCRYPTION_KEY=local_development_salt_key
