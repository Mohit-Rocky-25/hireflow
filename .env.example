# HireFlow AI — Environment Configuration Example
# COPY this file to .env for local development. Never commit .env to git.

# -------------------------------------------------------------
# SERVER-SIDE ONLY VARIABLES (used by Vite dev proxy middleware)
# These are NEVER bundled into client-side JavaScript.
# -------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# -------------------------------------------------------------
# CLIENT-FACING VARIABLES (Publicly accessible in client bundle)
# Rule: Never place private tokens or secret keys in VITE_ variables.
# -------------------------------------------------------------
# VITE_APP_ENV=development
