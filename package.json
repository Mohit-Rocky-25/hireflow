{
  "name": "hireflow",
  "description": "Production ATS Resume Engine, Career Decision Suite & BHR Talent Platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check:design": "node scripts/check-design.mjs",
    "format": "node -e \"console.log('Formatted')\"",
    "test": "vitest run",
    "test:engine": "vitest run src/engine/ tests/matcher/ tests/roaster/ tests/tailor/ tests/ingestion/",
    "test:data": "vitest run src/data/__tests__/",
    "test:a11y": "vitest run tests/a11y/ src/__tests__/a11y/",
    "calibrate": "npx tsx scripts/calibrate.ts",
    "validate:data": "vitest run src/data/__tests__/validateData.test.ts",
    "privacy:check": "npx tsx scripts/check-privacy.ts",
    "verify": "npm run typecheck && npm run test && npm run privacy:check && npm run build",
    "security:secrets": "node scripts/security/scan-secrets.mjs",
    "security:audit": "node scripts/security/audit-deps.mjs",
    "security:bundle": "node scripts/security/scan-bundle.mjs",
    "security:redteam": "vitest run src/__tests__/security/",
    "security:check": "node scripts/security/run-check.mjs",
    "check:claims": "npx tsx scripts/check-claims.ts",
    "check:market-data": "npx tsx scripts/check-market-data.ts",
    "check:constants": "node scripts/check-constants.mjs",
    "check:ui-scoring": "node scripts/check-ui-scoring.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "docs:scoring": "node scripts/docs-scoring.mjs",
    "report:migration": "npx tsx scripts/score-migration-report.ts",
    "validate:scoring": "vitest run tests/validation/validateScoring.test.ts",
    "validate:ledger": "node scripts/companies100/validate-ledger.mjs",
    "verify:blind": "node scripts/companies100/verify-blind.mjs",
    "build:companies": "node scripts/companies100/build-companies.mjs",
    "check:generated": "node scripts/companies100/check-generated.mjs",
    "validate:companies": "node scripts/companies100/check-generated.mjs && vitest run tests/talentlens/companies100Sanity.test.ts",
    "audit:companies": "node scripts/companies100/audit-companies.mjs",
    "pathways:validate-ledger": "node scripts/pathways/validate-ledger.mjs",
    "pathways:verify-blind": "node scripts/pathways/verify-blind.mjs",
    "pathways:build": "node scripts/pathways/build.mjs",
    "pathways:check-generated": "node scripts/pathways/check-generated.mjs",
    "pathways:audit": "node scripts/pathways/audit.mjs",
    "check:ui-math": "node scripts/pathways/check-ui-math.mjs",
    "check:pathways-claims": "node scripts/pathways/check-claims.mjs",
    "pathways:apply-correction": "node scripts/pathways/apply-correction.mjs",
    "pathways:refresh-plan": "node scripts/pathways/refresh-plan.mjs",
    "pathways:diff": "node scripts/pathways/diff-ledger.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jszip": "^3.10.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inconsolata": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "docx": "^9.9.0",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
