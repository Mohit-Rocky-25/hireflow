  "penaltyRules": [
    {
      "id": "missing_experience_section",
      "label": "Missing Work Experience Section",
      "severity": "high",
      "points": 8,
      "reason": "Resume lacks an identifiable work experience section. (Applicable to junior/mid/senior candidates; waived for entry-level/fresher).",
      "applicableLevels": ["junior", "mid", "senior", "lead"]
    },
    {
      "id": "missing_skills_section",
      "label": "Missing Skills Section",
      "severity": "medium",
      "points": 4,
      "reason": "No dedicated skills or competencies section detected, making machine keyword indexing slower.",
      "applicableLevels": ["entry", "junior", "mid", "senior", "lead"]
    },
    {
      "id": "missing_contact_info",
      "label": "Incomplete Contact Info",
      "severity": "high",
      "points": 5,
      "reason": "Missing both email and phone number, preventing recruiter outreach.",
      "applicableLevels": ["entry", "junior", "mid", "senior", "lead"]
    },
    {
      "id": "severe_brevity",
      "label": "Resume Too Brief",
      "severity": "high",
      "points": 7,
      "reason": "Resume word count is below minimum expected threshold for this seniority level.",
      "applicableLevels": ["junior", "mid", "senior", "lead"]
    },
    {
      "id": "extreme_brevity_entry",
      "label": "Resume Too Brief for Entry Level",
      "severity": "medium",
      "points": 4,
      "reason": "Resume is under 180 words, leaving insufficient detail to evaluate project or technical depth.",
      "applicableLevels": ["entry"]
    },
    {
      "id": "excessive_length",
      "label": "Excessive Resume Length",
      "severity": "low",
      "points": 3,
      "reason": "Resume length significantly exceeds standard multi-page limits for target seniority tier.",
      "applicableLevels": ["entry", "junior", "mid", "senior", "lead"]
    },
    {
      "id": "multi_column_table_artifacts",
      "label": "Multi-Column / Complex Table Artifacts",
      "severity": "medium",
      "points": 4,
      "reason": "Interleaved columns or table structure detected, risking parse corruption in traditional ATS systems.",
      "applicableLevels": ["entry", "junior", "mid", "senior", "lead"]
    }
  ]
}
