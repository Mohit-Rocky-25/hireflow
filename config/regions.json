{
  "$schema": "./schema/regions.schema.json",
  "version": "1.0.0",
  "defaultRegion": "generic",
  "regions": {
    "generic": {
      "id": "generic",
      "displayName": "Global / Generic Standard",
      "dateFormats": ["YYYY-MM", "MM/YYYY", "YYYY", "Month YYYY"],
      "phoneFormats": ["+[0-9]{1,3}[0-9\\s.-]{7,14}", "\\([0-9]{3}\\)\\s*[0-9]{3}-[0-9]{4}", "[0-9]{10}"],
      "gradeFormats": [
        { "type": "gpa_4", "label": "GPA (out of 4.0)" },
        { "type": "cgpa_10", "label": "CGPA (out of 10.0)" },
        { "type": "percentage", "label": "Aggregate Percentage (%)" }
      ],
      "resumeConventions": {
        "photoExpected": false,
        "dobExpected": false,
        "pageCountGuidance": "1 page recommended for 0-5 YOE, 2 pages for 5+ YOE"
      },
      "commonCodingProfiles": ["github.com", "leetcode.com", "hackerrank.com"],
      "professionalNetworks": ["linkedin.com"]
    },
    "us_ca": {
      "id": "us_ca",
      "displayName": "United States & Canada",
      "dateFormats": ["MM/YYYY", "Month YYYY", "YYYY"],
      "phoneFormats": ["\\([0-9]{3}\\)\\s*[0-9]{3}-[0-9]{4}", "[0-9]{3}-[0-9]{3}-[0-9]{4}", "\\+1[0-9]{10}"],
      "gradeFormats": [
        { "type": "gpa_4", "label": "GPA (out of 4.0)" }
      ],
      "resumeConventions": {
        "photoExpected": false,
        "dobExpected": false,
        "pageCountGuidance": "Strictly 1 page for <5 YOE; 2 pages acceptable for Senior/Staff"
      },
      "commonCodingProfiles": ["github.com", "leetcode.com", "kaggle.com"],
      "professionalNetworks": ["linkedin.com"]
    },
    "in": {
      "id": "in",
      "displayName": "India",
      "dateFormats": ["MM/YYYY", "YYYY", "Month YYYY"],
      "phoneFormats": ["\\+91[\\s-]?[6-9][0-9]{9}", "[6-9][0-9]{9}"],
      "gradeFormats": [
        { "type": "cgpa_10", "label": "CGPA (out of 10.0)" },
        { "type": "percentage", "label": "Aggregate Percentage (%)" }
      ],
      "resumeConventions": {
        "photoExpected": false,
        "dobExpected": false,
        "pageCountGuidance": "1 page ideal for on-campus / off-campus freshers; 2 pages standard for experienced"
      },
      "commonCodingProfiles": ["leetcode.com", "geeksforgeeks.org", "codeforces.com", "codechef.com", "github.com"],
      "professionalNetworks": ["linkedin.com", "naukri.com"]
    },
    "eu_uk": {
      "id": "eu_uk",
      "displayName": "Europe & United Kingdom",
      "dateFormats": ["DD/MM/YYYY", "MM/YYYY", "Month YYYY", "YYYY"],
      "phoneFormats": ["\\+[0-9]{2,3}[\\s-]?[0-9\\s.-]{7,12}"],
      "gradeFormats": [
        { "type": "class", "label": "Degree Classification (First, 2:1, 2:2)" },
        { "type": "ects", "label": "ECTS Grade Scale" }
      ],
      "resumeConventions": {
        "photoExpected": false,
        "dobExpected": false,
        "pageCountGuidance": "1-2 pages standard CV layout"
      },
      "commonCodingProfiles": ["github.com", "gitlab.com"],
      "professionalNetworks": ["linkedin.com", "xing.com"]
    }
  }
}
